@page "/vehicless"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using CarRentalManagement.Domain
@using CarRentalManagement.Data
@implements IAsyncDisposable
@inject IDbContextFactory<CarRentalManagement.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="vehicless/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Vehicles">
    <PropertyColumn Property="vehicles => vehicles.LicensePlateNumber" />
    <PropertyColumn Property="vehicles => vehicles.MakeId" />
    <PropertyColumn Property="vehicles => vehicles.ModelId" />
    <PropertyColumn Property="vehicles => vehicles.ColourId" />
    <PropertyColumn Property="vehicles => vehicles.Year" />
    <PropertyColumn Property="vehicles => vehicles.CreatedAt" />
    <PropertyColumn Property="vehicles => vehicles.updatedAt" />
    <PropertyColumn Property="vehicles => vehicles.CreatedBy" />
    <PropertyColumn Property="vehicles => vehicles.UpdatedBy" />

    <TemplateColumn Context="vehicles">
        <a href="@($"vehicless/edit?id={vehicles.Id}")">Edit</a> |
        <a href="@($"vehicless/details?id={vehicles.Id}")">Details</a> |
        <a href="@($"vehicless/delete?id={vehicles.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
